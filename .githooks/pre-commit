#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

printf '%s\n' 'Checking the working tree; this hook will not modify or stage files.'

if ! make format-check; then
    printf '%s\n' 'Formatting check failed. Run `make fmt`, review the changes, and stage only what you intend to commit.' >&2
    exit 1
fi

if ! make lint; then
    printf '%s\n' 'Lint failed or emitted a lint warning. Fix the reported issue, then rerun `make lint`.' >&2
    exit 1
fi

if ! make build-check; then
    printf '%s\n' 'Build failed or emitted a compiler warning. Fix the reported issue, then rerun `make build-check`.' >&2
    exit 1
fi

printf '%s\n' 'Pre-commit formatting, compiler-warning, and lint-warning checks passed.'
